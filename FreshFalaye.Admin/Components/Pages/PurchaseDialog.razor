@rendermode InteractiveServer

@using FreshFalaye.Admin.Components.Pages.Masters
@using FreshFalaye.Admin.Models
@using FreshFalaye.Admin.Services


@inherits BasePage
@inject PurchaseApiService PurchaseApi
@inject ProductGroupApiService ProductGroupApi
@inject ProductApiService ProductApi
@inject UnitApiService UnitApi
@inject AccountApiService PartyApi
@inject ExpenseMasterApiService ExpenseApi
@inject DialogService DialogService
@inject AdminAuthService Auth
@inject IJSRuntime JS
@implements IDisposable
@inject NavigationManager Nav

<RadzenCard Style="padding:12px">

    <!-- ================= HEADER ================= -->
    <div class="row g-2">

        <div class="col-md-3">
            <label class="form-label">Purchase Date</label>
            <input type="date"
                   class="form-control form-control-sm"
                   @bind="header.PurchaseDate" />
        </div>

        <div class="col-md-3">
            <label class="form-label">
                <div class="d-flex align-items-center">
                    <span class="me-1">Vendor</span>

                    <RadzenButton Icon="add_circle"
                                  Size="ButtonSize.Small"
                                  Click="@AddVendor"
                                  Style="background:none;border:none;padding:0;color:#0d6efd"
                                  Title="Add New Vendor" />
                </div>
                
            </label>
            <select class="form-select form-select-sm"
                    @bind="header.AccountId">
                <option value="">-- select --</option>
                @foreach (var p in parties)
                {
                    <option value="@p.Id">@p.AccountName</option>
                }
            </select>
        </div>

        <div class="col-md-3">
            <label class="form-label">Party Invoice No</label>
            <input class="form-control form-control-sm"
                   @bind="header.PartyInvoiceNo" />
        </div>

        <div class="col-md-3">
            <label class="form-label">Invoice No (Internal)</label>
            <input class="form-control form-control-sm"
                   @bind="header.InvoiceNo" disabled />
        </div>

        <div class="col-md-3">
            <label class="form-label">Vehicle No</label>
            <input class="form-control form-control-sm"
                   @bind="header.VehicleNo" />
        </div>

        <div class="col-md-3">
            <label class="form-label">Contact Name</label>
            <input class="form-control form-control-sm"
                   @bind="header.ContactPersonName" />
        </div>

        <div class="col-md-3">
            <label class="form-label">Contact Number</label>
            <input class="form-control form-control-sm"
                   @bind="header.ContactPersonNumber" />
        </div>

    </div>

    <hr />

    <!-- ================= ITEMS ================= -->
    <b>Items</b>

    <table class="table table-sm table-bordered mt-1">
        <thead class="table-light">
            <tr>
                <th style="width:40px">#</th>
                <th style="width:130px">
                    <div class="d-flex align-items-center">
                        <span class="me-1">Group</span>

                        <RadzenButton Icon="add_circle"
                                      Size="ButtonSize.Small" 
                                      Click="@AddProductGroup"
                                      Style="background:none;border:none;padding:0;color:#0d6efd"
                                      Title="Add New Produc Group" />
                    </div>                    
                </th>
                <th style="width:170px">
                    <div class="d-flex align-items-center">
                        <span class="me-1">Item</span>

                        <RadzenButton Icon="add_circle"
                                      Size="ButtonSize.Small"
                                      Click="@AddProduct"
                                      Style="background:none;border:none;padding:0;color:#0d6efd"
                                      Title="Add New Product" />
                    </div> 
                </th>
                <th style="width:100px">P. Unit</th>
                <th style="width:100px">Sec. Unit</th>
                <th style="width:100px">Conv.Ratio</th>
                <th style="width:80px">P. Qty</th>
                <th style="width:100px">Rate</th>
                <th style="width:70px">GST %</th>
                <th style="width:80px">Sec. Qty</th>                              
                <th style="width:100px">Amount</th>
                <th style="width:40px"></th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < items.Count; i++)
            {
                var index = i;
                var row = items[i];
                <tr>
                    <td>@(i + 1)</td>

                    <!-- Product Group -->
                    <td>                
                        <RadzenDropDown Data="@productGroups"
                                        TextProperty="GroupName"
                                        ValueProperty="ProductGroupId"
                                        @bind-Value="row.ProductGroupId"
                                        AllowFiltering="true"
                                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                        Style="width:100%"
                                        Change="@(value => OnGroupChanged(value, row))"
                                        Class="form-select form-select-sm" />                    
                    </td>

                    <!-- Product -->
                    <td>
                        <!-- Product -->

                        <RadzenDropDown TItem="Product"
                                        TValue="Guid"
                                        Data="@(products.Where(p => p.ProductGroupId == row.ProductGroupId))"
                                        TextProperty="ProductName"
                                        ValueProperty="ProductId"
                                        @bind-Value="row.ProductId"
                                        AllowFiltering="true"
                                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                        Change="@(value => OnProductChanged((Guid)value, row))"
                                        Style="width:100%"
                                        Class="form-select form-select-sm" />

                        @* <select class="form-select form-select-sm"
                                value="@row.ProductId"
                                @onchange="e => OnProductChanged(e, row)">
                            <option value="">--</option>
                            @foreach (var p in products.Where(p => p.ProductGroupId == row.ProductGroupId))
                            {
                                <option value="@p.ProductId">@p.ProductName</option>
                            }
                        </select> *@
                    </td>

                    <!-- Packing (Unit) -->
                    <td>
                        <select class="form-select form-select-sm"
                                value="@row.UnitId" disabled
                                @onchange="e => OnUnitChanged(e, row)">
                            <option value="">--</option>
                            @foreach (var u in units)
                            {
                                <option value="@u.UnitId">@u.UnitName</option>
                            }
                        </select>
                    </td>
                    <td>
                        <select class="form-select form-select-sm"
                                value="@row.SecondaryUnitId" disabled
                                @onchange="e => OnUnitChanged(e, row)">
                            <option value="">--</option>
                            @foreach (var u in units)
                            {
                                <option value="@u.UnitId">@u.UnitName</option>
                            }
                        </select>
                    </td>
                    <td>
                        <input type="number" disabled
                               step="0.01"
                               class="form-control form-control-sm"
                               value="@row.UnitConversionRatio" />
                    </td>
                    <!-- Qty -->
                    <td>
                        <input type="number"
                               step="0.01"
                               class="form-control form-control-sm"
                               value="@row.PrimaryUnitQty"
                               @oninput="e => OnPrimaryUnitQtyChanged(e, row)" />
                    </td>

                    <!-- Rate -->
                    <td>
                        <input type="number"
                               step="0.01"
                               class="form-control form-control-sm"
                               value="@row.Rate"
                               @oninput="e => OnRateChanged(e, row)" />
                    </td>


                    <!-- GST -->
                    <td class="text-end">@row.GstPercent</td>
                    <!-- Qty -->
                    <td>
                        <input type="number"
                               step="0.01"
                               class="form-control form-control-sm"
                               value="@row.Qty"
                               @oninput="e => OnQtyChanged(e, row)" />
                    </td>

                    


                    <!-- Amount -->
                    <td class="text-end">@row.Amount.ToString("0.00")</td>

                    <!-- Delete -->
                    <td class="text-center">
                        <button class="btn btn-sm btn-danger"
                                @onclick="() => RemoveItem(index)">
                            ✖
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <button class="btn btn-sm btn-secondary"
            @onclick="AddItem">
        ➕ Add Item
    </button>

    <hr />

    <!-- ================= EXPENSES ================= -->
    <b>
        <div class="d-flex align-items-center">
            <span class="me-1">Expenses</span>

            <RadzenButton Icon="add_circle"
                          Size="ButtonSize.Small"
                          Click="@AddExpense"
                          Style="background:none;border:none;padding:0;color:#0d6efd"
                          Title="Add New Expense" />
        </div> 
    </b>

    <table class="table table-sm table-bordered mt-1">
        <thead class="table-light">
            <tr>
                <th>Expense</th>
                <th style="width:80px">%</th>
                <th style="width:100px">Rate</th>
                <th style="width:120px">Amount</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var e in expenses)
            {
                <tr>
                    <td>@e.Expense</td>
                    <td>@e.RateType</td>
                    <td>
                        <input type="number"
                               step="0.1"
                               class="form-control form-control-sm"
                               value="@e.Rate"
                               @oninput="ev => OnExpenseRateChanged(ev, e)" />
                        @* @e.Rate *@
                    </td>
                    <td class="text-end">
                        @CalculateExpense(e).ToString("0.00")
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <hr />

    <!-- ================= TOTALS ================= -->
    <div class="text-end">
        
        <div><b>Item Total:</b> ₹ @ItemTotal.ToString("0.00")</div>
        <div><b>Expense Total:</b> ₹ @ExpenseTotal.ToString("0.00")</div>
        

        <div class="fs-5 d-flex justify-content-between align-items-start">
            <div>
                <b>Net Amount (In Words): @AmountToWords.Convert(NetAmount)</b>                
            </div>

            <div class="text-end">
                <b>Net Amount:</b> ₹ @NetAmount.ToString("0.00")
            </div>
        </div>

    </div>

    <hr />

    <!-- ================= ACTIONS ================= -->

    <div class="mt-3 d-flex">
        @if (Auth.HasPermission("Purchase.Delete"))
        { 
            @if (PurchaseId != null)
            {
                <RadzenButton Text="Delete (Del)"
                              Icon="delete"
                              ButtonStyle="ButtonStyle.Danger"
                              ButtonType="ButtonType.Button"
                              Size="ButtonSize.Small"
                              Click="@DeleteClick" />
            }
        }
        

        <div class="ms-auto">
            @if (Auth.HasPermission("Purchase.Edit") || Auth.HasPermission("Purchase.Create"))
            { 
                <RadzenButton Text="Save (Alt+S)"
                              ButtonType="ButtonType.Button"
                              Size="ButtonSize.Small"
                              Click="@Save"
                              Disabled="@isSaving"
                              IsBusy="@isSaving"
                              BusyText="Saving..." />
            }
            

            <RadzenButton Text="Cancel (Esc)"
                          ButtonType="ButtonType.Button"
                          Size="ButtonSize.Small"
                          Click="@Close"
                          Style="margin-left:5px" />
        </div>
    </div>    

</RadzenCard>

@code {

    [Parameter] public Guid? PurchaseId { get; set; }

    PurchaseHeaderDto header = new()
    {
        PurchaseDate = DateTime.Today
    };

    bool dataLoaded;
    bool isSaving = false;

    List<PurchaseItemDto> items = new();
    List<PurchaseExpenseDto> expenses = new();
    DotNetObjectReference<PurchaseDialog>? objRef;

    List<ProductGroupDto> productGroups = new();
    List<ProductDto> products = new();
    List<UnitDto> units = new();
    List<AccountDto> parties = new();

    protected override async Task OnInitializedAsync()
    {
        Auth.OnChange += HandleAuthChanged;
    }

    void HandleAuthChanged()
    {
        _ = InvokeAsync(async () =>
        {
            if (!dataLoaded &&
                Auth.IsInitialized &&
                Auth.CurrentUser != null)
            {
                await LoadDataAsync();
            }
        });
    }
    public void Dispose()
    {
        Auth.OnChange -= HandleAuthChanged;
        objRef?.Dispose();
    }

    /* ---------------- Data ---------------- */

    async Task LoadDataAsync()
    {
        dataLoaded = true;

        productGroups = await ProductGroupApi.GetGroupsAsync();
        products = await ProductApi.GetProductsAsync();
        units = await UnitApi.GetUnitsAsync();
        parties = await PartyApi.GetAccountsAsync();

        if(parties.Count > 0)
        {
            parties = parties.Where(p => p.AccountGroupName.ToUpper() == "VENDOR").ToList();
        }

        expenses = await ExpenseApi.GetPurchaseExpensesAsync();

        if (PurchaseId.HasValue)
        {
            var dto = await PurchaseApi.GetAsync(PurchaseId.Value);
            header = dto.Header;
            items = dto.Items;
            expenses = dto.Expenses;
        }
        else
        {
            AddItem();
        }

        await InvokeAsync(StateHasChanged);
    }
    async Task AddVendor()
    {
        await DialogService.OpenAsync<AccountDialog>(
          "Add Account",
          null,
          new DialogOptions
          {
              Width = "720px",
              CloseDialogOnEsc = true,
              Draggable = true,
              Resizable = false
          });
        parties = await PartyApi.GetAccountsAsync();

        if (parties.Count > 0)
        {
            parties = parties.Where(p => p.AccountGroupName.ToUpper() == "VENDOR").ToList();
        }
        StateHasChanged();
    }
    async Task AddProduct()
    {
        await DialogService.OpenAsync<ProductDialog>(
            "Add Product",
            null,
            new DialogOptions { Width = "720px", CloseDialogOnEsc = true, Draggable = true, Resizable = false });


        products = await ProductApi.GetProductsAsync();
        StateHasChanged();

    }
    async Task AddProductGroup()
    {
        await DialogService.OpenAsync<ProductGroupDialog>(
             "Add Product Group",
             null,
             new DialogOptions
             {
                 Width = "520px",
                 CloseDialogOnEsc = true,
                 Draggable = true,
                 Resizable = false
             });

        productGroups = await ProductGroupApi.GetGroupsAsync();
        StateHasChanged();

    }

    async Task AddExpense()
    {
        await DialogService.OpenAsync<ExpenseMasterDialog>(
            "Add Expense",
            null,
            new DialogOptions
            {
                Width = "720px",
                CloseDialogOnEsc = true,
                Draggable = true,
                Resizable = false
            });

        expenses = await ExpenseApi.GetPurchaseExpensesAsync();
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            objRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("registerDialogShortcuts", objRef);


            if (!dataLoaded &&
                Auth.IsInitialized &&
                Auth.CurrentUser != null)
            {
                await LoadDataAsync();
            }            
        }
    }
    private void OnGroupChanged(object value, PurchaseItemDto row)
    {
        if (Guid.TryParse(value?.ToString(), out var groupId))
        {
            row.ProductGroupId = groupId;

            // Reset product when group changes
            row.ProductId = Guid.Empty;
            row.Rate = 0;
            row.Amount = 0;
        }
    }

    // void OnGroupChanged(ChangeEventArgs e, PurchaseItemDto row)
    // {
    //     if (Guid.TryParse(e.Value?.ToString(), out var groupId))
    //     {
    //         row.ProductGroupId = groupId;

    //         // Reset product when group changes
    //         row.ProductId = Guid.Empty;
    //         row.Rate = 0;
    //         row.Amount = 0;
    //     }
    // }

    void OnUnitChanged(ChangeEventArgs e, PurchaseItemDto row)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var unitId))
            row.UnitId = unitId;
    }



    void OnExpenseRateChanged(ChangeEventArgs ev, PurchaseExpenseDto e)
    {
        if (decimal.TryParse(ev.Value?.ToString(), out var rate))
        {
            e.Rate = rate;
        }

        // No need to explicitly call StateHasChanged
        // Blazor will re-render automatically
    }

    void AddItem()
    {
        items.Add(new PurchaseItemDto
        {

        });
    }

    void RemoveItem(int index)
    {
        items.RemoveAt(index);
    }

    void OnProductChanged(Guid value, PurchaseItemDto row)
    {
        if (!Guid.TryParse(value.ToString(), out var productId))
            return;

        row.ProductId = productId;

        var product = products.FirstOrDefault(p => p.ProductId == productId);
        if (product != null)
        {
            row.GstPercent = product.GstPercent;
            row.UnitId= product.UnitId;
            row.SecondaryUnitId = product.SecondaryUnitId;
            row.UnitConversionRatio = product.UnitConversionRatio;
            row.AmountCalculatedOnUnit = product.AmountCalculatedOnUnit;
            //row.Rate = product.SalePrice; // optional default
        }

        Recalculate(row);
    }

    void OnQtyChanged(ChangeEventArgs e, PurchaseItemDto row)
    {
        if (decimal.TryParse(e.Value?.ToString(), out var qty))
            row.Qty = Math.Round(qty,2);

        Recalculate(row);
    }
    void OnPrimaryUnitQtyChanged(ChangeEventArgs e, PurchaseItemDto row)
    {
        if (decimal.TryParse(e.Value?.ToString(), out var qty))
            row.PrimaryUnitQty = Math.Round(qty,2);

        row.Qty = row.PrimaryUnitQty * row.UnitConversionRatio;
        row.Qty = Math.Round(row.Qty, 2);
        Recalculate(row);
    }


    void OnRateChanged(ChangeEventArgs e, PurchaseItemDto row)
    {
        if (decimal.TryParse(e.Value?.ToString(), out var rate))
            row.Rate = Math.Round(rate,2);

        Recalculate(row);
    }

    void Recalculate(PurchaseItemDto row)
    {
        if (row.AmountCalculatedOnUnit == "Primary")
        {
            row.Amount = row.PrimaryUnitQty * row.Rate;
        }
        else if (row.AmountCalculatedOnUnit == "Secondary")
        {
            row.Amount = row.Qty * row.Rate;
        }
        row.Amount = Math.Round(row.Amount);
    }

    decimal CalculateExpense(PurchaseExpenseDto e)
    {
        int sign = e.AddDeduct == "Add" ? 1 : -1;
        if (e.RateType == "%")
        {
            return sign * (ItemTotal * e.Rate / 100);
        }
        else if (e.RateType == "@")
        {
            return sign * (TotalQty * e.Rate);
        }
        else
        {
            return sign * e.Rate;
        }
    }    

    decimal ItemTotal => items.Sum(x => x.Amount);
    decimal TotalQty => items.Sum(x => x.Qty);
    decimal ExpenseTotal => expenses.Sum(CalculateExpense);
    decimal NetAmount => ItemTotal + ExpenseTotal;

    async Task Save()
    {

        if (isSaving) return;

        isSaving = true;

        try
        {
            var dto = new PurchaseSaveDto
                {
                    Header = header,
                    Items = items,
                    Expenses = expenses
                };

            if (dto.Header.BranchId == Guid.Empty)
            {
                dto.Header.BranchId = Auth.CurrentUser.BranchId;
            }

            if (dto.Header.AccountId == Guid.Empty)
            {
                ShowError("Please select Vendor");
                return;
            }
            if (string.IsNullOrWhiteSpace(dto.Header.PartyInvoiceNo))
            {
                ShowError("Please enter Party Invoice No.");
                return;
            }

            foreach(var _item in dto.Items)
            {
                if (_item.ProductGroupId == Guid.Empty)
                {
                    ShowError("Please select Product Group");
                    return;
                }
                else if (_item.ProductId == Guid.Empty)
                {
                    ShowError("Please select Product");
                    return;
                }
                else if (_item.UnitId == Guid.Empty)
                {
                    ShowError("Primary Unit cannot be blank");
                    return;
                }
                else if (_item.SecondaryUnitId == null || _item.SecondaryUnitId == Guid.Empty)
                {
                    ShowError("Secondary Unit cannot be blank");
                    return;
                }
                else if (_item.PrimaryUnitQty <= 0)
                {
                    ShowError("Enter Primary Qty");
                    return;
                }
                else if (_item.Rate <= 0)
                {
                    ShowError("Enter Rate");
                    return;
                }
                else if (_item.Qty <= 0)
                {
                    ShowError("Enter Secondary Qty");
                    return;
                }
                else if (_item.Amount <= 0)
                {
                    ShowError("Amount should be greater than zero");
                    return;
                }
            }

            decimal _totalQty = dto.Items.Sum(x => x.PrimaryUnitQty);
            decimal _grossAmount = dto.Items.Sum(x => x.Amount);

            foreach (var _expense in dto.Expenses)
            {
                if (_expense.RateType == "@")
                {
                    _expense.Amount = _expense.Rate * _totalQty;
                }
                else if (_expense.RateType == "%")
                {
                    _expense.Amount = (_expense.Rate * _grossAmount) / 100;
                }
                else
                {
                    _expense.Amount = _expense.Rate;
                }
                _expense.ExpenseName = _expense.ExpenseName;
            }


            var response = PurchaseId == null
                                ? await PurchaseApi.CreateAsync(dto)
                                : await PurchaseApi.UpdateAsync(dto);

            await HandleApiResponse(response);

            DialogService.Close(true);

            //Nav.NavigateTo("/stock/purchase");
        }
        catch (ApiException ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Error", ex.Message);
        }
        finally
        {
            isSaving = false;    
        }
    }

    async Task DeleteClick()
    {
        if (PurchaseId!=null && PurchaseId != Guid.Empty)
        {
            bool? confirm = await DialogService.Confirm(
                $"Delete purchase '{PurchaseId.ToString()}'?",
                "Confirm Delete");

            if (confirm == true)
            {
                var response = await PurchaseApi.DeleteAsync(PurchaseId.Value);
                await HandleApiResponse(response);
                StateHasChanged();
                DialogService.Close();
            }
        }        
    }

    void ShowError(string message)
    {
        NotificationService.Notify(new NotificationMessage
        {
            Severity = NotificationSeverity.Error,
            Summary = "Error",
            Detail = message,
            Duration = 4000
        });
    }

    void Close() => DialogService.Close();
}
