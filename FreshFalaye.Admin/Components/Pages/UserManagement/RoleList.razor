@page "/admin/roles"

@rendermode InteractiveServer
@using FreshFalaye.Admin.Models
@using FreshFalaye.Admin.Services
@inherits BasePage

@inject RoleApiService Api
@inject DialogService DialogService
@inject AdminAuthService Auth

<RadzenCard Style="padding:10px;height:85vh;display:flex;flex-direction:column">

    <div class="d-flex mb-2">
        <b>Roles</b>
        @if (Auth.HasPermission("UserManagement.Create"))
        {
            <RadzenButton Text="Add (Alt+A)"
                          Icon="add"
                          AccessKey="A"
                          ButtonStyle="ButtonStyle.Primary"
                          Size="ButtonSize.Small"
                          Click="@AddClick"
                          Style="margin-left:auto" />

        }
        
    </div>

    <RadzenDataGrid Data="@roles"
                    TItem="RoleDto"
                    @ref="grid"
                    AllowFiltering="true"
                    AllowSorting="true"
                    RowDoubleClick="@EditClick"
                    Style="flex:1">

        <Columns>
            <RadzenDataGridColumn Property="RoleName" Title="Role Name" Width="180px" />
            <RadzenDataGridColumn Property="Description" Title="Description" />

            <RadzenDataGridColumn Title="Active" Width="100px">
                <Template Context="row">
                    <RadzenCheckBox Value="@row.IsActive" Disabled="true" />
                </Template>
            </RadzenDataGridColumn>
        </Columns>

    </RadzenDataGrid>

</RadzenCard>


@code {

    List<RoleDto> roles = new();
    RadzenDataGrid<RoleDto> grid;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    async Task LoadData()
    {
        roles = await Api.GetRolesAsync();
    }

    async Task AddClick()
    {
        await DialogService.OpenAsync<RoleDialog>(
            "Add Role",
            null,
            new DialogOptions { Width = "500px" });

        await LoadData();
        await grid.Reload();
    }

    async Task EditClick(DataGridRowMouseEventArgs<RoleDto> args)
    {
        var param = new Dictionary<string, object>
        {
            { "RoleId", args.Data.Id }
        };

        await DialogService.OpenAsync<RoleDialog>(
            "Edit Role",
            param,
            new DialogOptions { Width = "500px" });

        await LoadData();
        await grid.Reload();
    }
}
