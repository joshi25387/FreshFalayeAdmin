    void OnQtyChanged(ChangeEventArgs e, SaleItemDto row)
    {
        if (!decimal.TryParse(e.Value?.ToString(), out var qty))
            return;

        row.Qty = qty;

        // 🔥 Group total qty for same product
        var groupedItems = items
            .Where(x => x.ProductId == row.ProductId);

        var totalQtyForProduct = groupedItems.Sum(x => x.Qty);

        var product = products.FirstOrDefault(p => p.ProductId == row.ProductId);
        var stock = product?.AvailableQty ?? 0;

        // 🔥 Add back original qty in edit mode
        if (SaleId.HasValue)
        {
            var originalQty = groupedItems.Sum(x => x.OriginalQty);
            stock += originalQty;
        }

        if (totalQtyForProduct > stock)
        {
            if (!NegativeSaleAllowed)
            {
                // 🔥 Strict mode → block
                row.Qty = 0;

                NotificationService.Notify(
                    NotificationSeverity.Warning,
                    "Stock Warning",
                    $"Only {stock} items available"
                );
            }
            else
            {
                // 🔥 Flexible mode → allow but warn
                NotificationService.Notify(
                    NotificationSeverity.Warning,
                    "Negative Stock",
                    $"{product?.ProductName} stock will go negative."
                );
            }
        }

        Recalculate(row);
        StateHasChanged();
    }


    bool ValidateStock(out string message)
    {
        if (items == null || items.Count == 0)
        {
            message = "At least one item must be added.";
            return false;
        }

        // 🔥 Group by Product
        foreach (var group in items.GroupBy(x => x.ProductId))
        {
            var productId = group.Key;

            if (productId == null || productId == Guid.Empty)
            {
                message = "Please select product for all rows.";
                return false;
            }

            var product = products.FirstOrDefault(p => p.ProductId == productId);
            var stock = product?.AvailableQty ?? 0;

            // 🔥 Total qty entered in current bill
            var totalBillQty = group.Sum(x => x.Qty);

            // 🔥 Add back original qty in edit mode
            if (SaleId.HasValue)
            {
                var originalQty = group.Sum(x => x.OriginalQty);
                stock += originalQty;
            }

            if (!NegativeSaleAllowed && totalBillQty > stock)
            {
                message = $"Insufficient stock for {product?.ProductName}. Available: {stock}";
                return false;
            }
        }

        message = string.Empty;
        return true;
    }


