    async Task Save()
    {        
        if (isSaving) return;

        isSaving = true;

        try
        {

            if (!ValidateStock(out var errorMessage))
            {
                NotificationService.Notify(
                    NotificationSeverity.Error,
                    "Validation Error",
                    errorMessage
                );
                return;
            }

            foreach (var item in items)
            {
                var product = products.FirstOrDefault(p => p.ProductId == item.ProductId);
                if (product != null)
                {
                    item.ProductName = product.ProductName;

                    var unit = units.FirstOrDefault(u => u.UnitId == product.UnitId);
                    if (unit != null)
                        item.UnitCode = unit.UnitCode;
                }
            }

            var appliedExpenses = expenses
            .Where(e => e.IsApplied)
            .ToList();

            // 🔥 FINALIZE EXPENSE AMOUNTS BEFORE SEND
            foreach (var e in appliedExpenses)
            {
                if (e.RateType == "%")
                    e.Amount = (ItemTotal * e.Rate) / 100;
                else if (e.RateType == "@")
                    e.Amount = TotalQty * e.Rate;
                else
                    e.Amount = e.Rate;
            }
            // if (NegativeSaleAllowed)
            // {
            //     foreach (var group in items.GroupBy(x => x.ProductId))
            //     {
            //         var product = products.FirstOrDefault(p => p.ProductId == group.Key);
            //         var stock = product?.AvailableQty ?? 0;
            //         var totalQty = group.Sum(x => x.Qty);

            //         if (totalQty > stock)
            //         {
            //             NotificationService.Notify(
            //                 NotificationSeverity.Warning,
            //                 "Negative Stock",
            //                 $"{product?.ProductName} stock will go negative."
            //             );
            //         }
            //     }
            // }


            var dto = new SaleSaveDto
            {
                SyncId = header.SyncId,
                BranchId = header.BranchId,
                SaleDate = header.SaleDate,
                BillNo = header.BillNo,
                CustomerMobile = header.CustomerMobile,
                CustomerName = header.CustomerName,
                PaymentMode = header.PaymentMode,
                GrandTotal = NetAmount,
                SubTotal = ItemTotal,

                Items = items,
                Expenses = appliedExpenses
            };

            dto.BranchId = Auth.CurrentUser.BranchId;




            var response = SaleId == null
                            ? await SaleApi.CreateAsync(dto)
                            : await SaleApi.UpdateAsync(dto);

            await HandleApiResponse(response);

            Nav.NavigateTo("/stock/sales");
        }
        catch (ApiException ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Error", ex.Message);           
        }
        finally
        {
            isSaving = false;
        }
    }

    async Task DeleteClick()
    {
        if (SaleId!=null && SaleId != Guid.Empty)
        {
            bool? confirm = await DialogService.Confirm(
                $"Delete sale '{SaleId.ToString()}'?",
                "Confirm Delete");

            if (confirm == true)
            {
                var response = await SaleApi.DeleteAsync(SaleId.Value);
                await HandleApiResponse(response);
                StateHasChanged();
                DialogService.Close();
            }
        }        
    }


    void Close() => DialogService.Close();
