    void OnRateChanged(ChangeEventArgs e, SaleItemDto row)
    {
        if (decimal.TryParse(e.Value?.ToString(), out var rate))
            row.Rate = rate;

        Recalculate(row);
    }

    // int GetAvailableStock(Guid productId)
    // {
    //     var product = products.FirstOrDefault(p => p.ProductId == productId);
    //     return product?.AvailableQty ?? 0;
    // }
    decimal GetAvailableStock(Guid? productId)
    {
        if (productId == null)
            return 0;

        var product = products.FirstOrDefault(p => p.ProductId == productId);
        return product?.AvailableQty ?? 0;
    }

    void Recalculate(SaleItemDto row)
    {
        row.TotalAmount = row.Qty * row.Rate;
    }

    void OnExpenseRateChanged(ChangeEventArgs ev, SaleExpenseDto e)
    {
        if (decimal.TryParse(ev.Value?.ToString(), out var rate))
            e.Rate = rate;
    }

    decimal CalculateExpense(SaleExpenseDto e)
    {
        int sign = e.AddDeduct == "Add" ? 1 : -1;

        if (e.RateType == "%")
            return sign * (ItemTotal * e.Rate / 100);

        if (e.RateType == "@")
            return sign * (TotalQty * e.Rate);

        return sign * e.Rate;
    }

    decimal ItemTotal => items.Sum(x => x.TotalAmount);
    decimal TotalQty => items.Sum(x => x.Qty);
    decimal ExpenseTotal => expenses.Where(e => e.IsApplied).Sum(CalculateExpense);
    decimal NetAmount => ItemTotal + ExpenseTotal;    


    // async Task Save()
    // {
    //     var dto = new SaleSaveDto
    //     {            
    //         Items = items,
    //         Expenses = expenses
    //     };

    //     dto.BranchId = Auth.CurrentUser.BranchId;

    //     var response = SaleId == null
