@rendermode InteractiveServer

@using FreshFalaye.Admin.Models
@using FreshFalaye.Admin.Services

@inherits BasePage
@inject SaleApiService SaleApi
@inject ProductGroupApiService ProductGroupApi
@inject ProductApiService ProductApi
@inject UnitApiService UnitApi
@inject AccountApiService AccountApi
@inject ExpenseMasterApiService ExpenseApi
@inject DialogService DialogService
@inject AdminAuthService Auth
@inject NavigationManager Nav

<RadzenCard Style="padding:12px">

    <!-- ================= HEADER ================= -->
    <div class="row g-2">

        <div class="col-md-2">
            <label class="form-label">Sale Date</label>
            <input type="date"
                   class="form-control form-control-sm"
                   @bind="header.SaleDate" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Bill No.</label>
            <input class="form-control form-control-sm" disabled
                   @bind="header.BillNo" />
        </div>

        <div class="col-md-3">
            <label class="form-label">Customer Name</label>
            <input class="form-control form-control-sm"
                   @bind="header.CustomerName" />
        </div>

        <div class="col-md-2">
            <label class="form-label">Mobile</label>
            <input class="form-control form-control-sm"
                   @bind="header.CustomerMobile" />
        </div>

        <div class="col-md-2">
            <label class="form-label">Payment Mode</label>
            <select class="form-select form-select-sm"
                    @bind="header.PaymentMode">
                <option>Cash</option>
                <option>UPI</option>
                <option>Credit</option>
            </select>
        </div>

    </div>

    <hr />

    <!-- ================= ITEMS ================= -->
    <b>Items</b>

    <div class="table-scroll-wrapper">
        <table class="table table-sm table-bordered mt-1">
            <thead class="table-light">
                <tr>
                    <th style="width:40px">#</th>
                    <th style="width:200px">Group</th>
                    <th style="width:220px">Item</th>
                    <th style="width:120px">Unit</th>
                    <th style="width:80px">Stock</th>
                    <th style="width:80px">Qty</th>
                    <th style="width:80px">MRP</th>
                    <th style="width:80px">Disc %</th>
                    <th style="width:100px">Rate</th>
                    <th style="width:120px">Amount</th>
                    <th style="width:40px"></th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < items.Count; i++)
                {
                    var index = i;
                    var row = items[i];

                    var availableStock = GetAvailableStock(row.ProductId);
                    <tr class="@(row.Qty > availableStock ? "table-danger" : "")">
                        <td>@(i + 1)</td>

                        <td>
                            <select class="form-select form-select-sm"
                                    value="@row.ProductGroupId"
                                    @onchange="e => OnGroupChanged(e, row)">
                                <option value="">--</option>
                                @foreach (var g in productGroups)
                                {
                                    <option value="@g.ProductGroupId">@g.GroupName</option>
                                }
                            </select>
                        </td>

                        <td>
                            <select class="form-select form-select-sm"
                                    value="@row.ProductId"
                                    @onchange="e => OnProductChanged(e, row)">
                                <option value="">--</option>
                                @foreach (var p in products.Where(p => p.ProductGroupId == row.ProductGroupId))
                                {
                                    <option value="@p.ProductId">@p.ProductName</option>
                                }
                            </select>
                        </td>

                        <td>
                            <select class="form-select form-select-sm"
                                    value="@row.UnitId" disabled
                                    @onchange="e => OnUnitChanged(e, row)">
                                <option value="">--</option>
                                @foreach (var u in units)
                                {
                                    <option value="@u.UnitId">@u.UnitName</option>
                                }
                            </select>
                        </td>

                        <td class="text-end">
                            @availableStock
                        </td>

                        <td>
                            <input type="number"
                                   step="0.01"
                                   class="form-control form-control-sm"
                                   value="@row.Qty"
                                   @oninput="e => OnQtyChanged(e, row)" />



                        </td>
                        <td>
                            <input type="number"
                                   step="0.01"
                                   class="form-control form-control-sm"
                                   value="@row.Mrp" />
                        </td>
                        <td>
                            <input type="number"
                                   step="0.01"
                                   class="form-control form-control-sm"
                                   value="@row.Discount" />
                        </td>
                        <td>
                            <input type="number"
                                   step="0.01"
                                   class="form-control form-control-sm"
                                   value="@row.Rate"
                                   @oninput="e => OnRateChanged(e, row)" />
                        </td>

                        <td class="text-end">@row.TotalAmount.ToString("0.00")</td>

                        <td class="text-center">
                            <button class="btn btn-sm btn-danger"
                                    @onclick="() => RemoveItem(index)">
                                ✖
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <button class="btn btn-sm btn-secondary"
            @onclick="AddItem">
        ➕ Add Item
    </button>

    <hr />

    <!-- ================= EXPENSES ================= -->
    <b>Expenses</b>

    <table class="table table-sm table-bordered mt-1">
        <thead class="table-light">
            <tr>
                <th style="width:40px"></th>
                <th>Expense</th>
                <th style="width:80px">Type</th>
                <th style="width:100px">Rate</th>
                <th style="width:120px">Amount</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var e in expenses)
            {
                <tr>
                    <!-- 🔥 Checkbox -->
                    <td class="text-center">
                        <input type="checkbox"
                               @bind="e.IsApplied" />
                    </td>
                    <td>@e.ExpenseName</td>
                    <td>@e.RateType</td>

                    <td>
                        <input type="number"
                               class="form-control form-control-sm"
                               value="@e.Rate"
                               disabled="@(!e.IsApplied)"
                               @oninput="ev => OnExpenseRateChanged(ev, e)" />
                    </td>

                    <td class="text-end">
                        @(e.IsApplied ? CalculateExpense(e).ToString("0.00") : "0.00")
                    </td>                    
                </tr>
            }
        </tbody>
    </table>

    <hr />

    <!-- ================= TOTALS ================= -->
    <div class="text-end">
        <div><b>Item Total:</b> ₹ @ItemTotal.ToString("0.00")</div>
        <div><b>Expense Total:</b> ₹ @ExpenseTotal.ToString("0.00")</div>

        <div class="fs-5 d-flex justify-content-between">
            <div>
                <b>Net Amount (In Words): @AmountToWords.Convert(NetAmount)</b>
            </div>
            <div>
                <b>Net Amount:</b> ₹ @NetAmount.ToString("0.00")
            </div>
        </div>
    </div>

    <hr />

    <!-- ================= ACTIONS ================= -->


    <div class="mt-3 d-flex">

        @if (SaleId != null)
        {
            <RadzenButton Text="Delete (Del)"
                          Icon="delete"
                          ButtonStyle="ButtonStyle.Danger"
                          ButtonType="ButtonType.Button"
                          Size="ButtonSize.Small"
                          Click="@DeleteClick" />
        }

        <div class="ms-auto">
            <RadzenButton Text="Save (Alt+S)"
                          ButtonType="ButtonType.Button"
                          Size="ButtonSize.Small"
                          Click="@Save"
                          Disabled="@isSaving"
                          IsBusy="@isSaving"
                          BusyText="Saving..." />

            <RadzenButton Text="Cancel (Esc)"
                          ButtonType="ButtonType.Button"
                          Size="ButtonSize.Small"
                          Click="@Close"
                          Style="margin-left:5px" />
        </div>
    </div>   
</RadzenCard>

@code {

    [Parameter] public Guid? SaleId { get; set; }

    SaleHeaderDto header = new()
    {
        SaleDate = DateTime.Today,
        PaymentMode = "UPI"
    };

    List<SaleItemDto> items = new();
    List<SaleExpenseDto> expenses = new();

    List<ProductGroupDto> productGroups = new();
    List<ProductDto> products = new();
    List<UnitDto> units = new();
    List<AccountDto> customers = new();

    bool NegativeSaleAllowed = true;

    bool isSaving = false;

    protected override async Task OnInitializedAsync()
    {
        productGroups = await ProductGroupApi.GetGroupsAsync();
        products = await ProductApi.GetProductsWithStockAsync();
        units = await UnitApi.GetUnitsAsync();

        expenses = await ExpenseApi.GetSaleExpensesAsync();

        if (SaleId.HasValue)
        {
            var dto = await SaleApi.GetAsync(SaleId.Value);
            header.BranchId = dto.BranchId;
            header.SaleDate = dto.SaleDate;
            header.BillNo = dto.BillNo;
            header.CustomerMobile = dto.CustomerMobile;
            header.CustomerName = dto.CustomerName;
            header.PaymentMode = dto.PaymentMode;
            header.SaleId = dto.Id;
            header.SyncId = dto.SyncId;
            items = dto.Items;

            foreach (var item in items)
            {
                item.OriginalQty = item.Qty; // 🔥 Store original qty
            }

            // 🔥 Mark applied expenses
            foreach (var masterExpense in expenses)
            {
                var applied = dto.Expenses
                    .FirstOrDefault(e => e.ExpenseId == masterExpense.ExpenseId);

                if (applied != null)
                {
                    masterExpense.IsApplied = true;
                    masterExpense.Rate = applied.Rate;
                    masterExpense.RateType = applied.RateType;
                    masterExpense.AddDeduct = applied.AddDeduct;
                    masterExpense.Bearer = applied.Bearer;
                }
                else
                {
                    masterExpense.IsApplied = false;
                }
            }

            //expenses = dto.Expenses;
        }
        else
        {
            AddItem();
        }
    }

    void AddItem()
    {
        items.Add(new SaleItemDto
        {
            Qty = 1,
            OriginalQty = 0 // 🔥 Important for edit mode
        });
        //items.Add(new SaleItemDto { Qty = 1 });
    }

    void RemoveItem(int index)
    {
        items.RemoveAt(index);
    }

    void OnGroupChanged(ChangeEventArgs e, SaleItemDto row)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var id))
        {
            row.ProductGroupId = id;
            row.ProductId = Guid.Empty;
        }
    }

    void OnProductChanged(ChangeEventArgs e, SaleItemDto row)
    {
        if (!Guid.TryParse(e.Value?.ToString(), out var productId))
            return;

        row.ProductId = productId;

        var product = products.FirstOrDefault(p => p.ProductId == productId);
        if (product != null)
        {
            row.ProductName = product.ProductName; 
            row.Discount = product.Discount;
            row.Mrp = product.Mrp;
            row.Rate = product.SalePrice;
            row.UnitId = product.UnitId; 

            var unit = units.FirstOrDefault(u => u.UnitId == product.UnitId);
            if (unit != null)
            {
                row.UnitCode = unit.UnitCode;        // 🔥 ADD THIS
            }
        }

        Recalculate(row);
    }

    void OnUnitChanged(ChangeEventArgs e, SaleItemDto row)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var unitId))
            row.UnitId = unitId;
    }

